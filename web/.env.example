# Copy to .env and fill in values from your Auth0 tenant.
# VITE_AUTH0_CLIENT_ID is the web app client_id output by terraform apply.
# VITE_AUTH0_CONNECTION must match the connection name created by terraform
# (formatted as "<app_name>-db", e.g. "My-App-db").

VITE_AUTH0_DOMAIN=dev-XXXXXXXX.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_CONNECTION=My-App-db
